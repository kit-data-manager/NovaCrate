{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "NovaCrate",
    "version": "1.14.2",
    "identifier": "edu.kit.datamanager.novacrate.desktop",
    "build": {
        "devUrl": "http://localhost:3000",
        "beforeDevCommand": "cd .. && cross-env PERSISTENCE_BACKEND=desktop npm run dev",
        "beforeBuildCommand": "cd .. && cross-env PERSISTENCE_BACKEND=desktop npm run build",
        "frontendDist": "../out"
    },
    "app": {
        "windows": [
            {
                "title": "NovaCrate",
                "width": 1280,
                "height": 800,
                "minWidth": 800,
                "minHeight": 600
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"]
    }
}
